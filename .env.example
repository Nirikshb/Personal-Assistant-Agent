# Copy this file to .env and fill in local values.
# Never commit .env.

NODE_ENV=development
PORT=3000

# Local Ollama — used by src/ollama only
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# NestJS Observe — leave empty to disable locally
NEST_OBSERVE_APP_KEY=
NEST_OBSERVE_APP_SECRET=
NEST_OBSERVE_SERVICE_ID=ai-assistant

# Gmail OAuth — used by src/gmail only. See docs/gmail.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/gmail/callback

# Web — used by src/web only. See docs/web.md and docs/you_to_do.md Part F
# Need Tavily OR Brave for search. Jina works without a key for light reads.
TAVILY_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=
# Optional: Browserless Playwright websocket. Empty = local Chromium.
BROWSERLESS_WS=
